{
  "id":"2026-09-10-058b",
  "title":"Recover stale OpenClaw lane worker",
  "description":"If and only if the OpenClaw lane is still RUNNING with stale state for at least 90 seconds, terminate only that worker process tree and verify the supervisor coordinator restarts a fresh OpenClaw worker. Do not touch Security Monitor resources.",
  "risk":"medium",
  "backup":"Write-Output 'V462_058B_BACKUP=PROCESS_RECOVERY_ONLY'",
  "script":"$u='https://raw.githubusercontent.com/3en4all/3en-command-runner/8ec4075429c4608080041f519b840424ac12d30e/scripts/recover-stuck-openclaw-worker-058b.ps1';$d='C:/3EN-Agent/recover-stuck-openclaw-worker-058b.ps1';Invoke-WebRequest -UseBasicParsing -Uri $u -OutFile $d;& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $d",
  "test":"$p='C:/3EN-Agent/workbench/admin-recovery-058b.json';if(-not(Test-Path $p)){throw '058B_RECOVERY_EVIDENCE_MISSING'};$e=Get-Content $p -Raw|ConvertFrom-Json;if([string]$e.status -notin @('PASS','NO_RECOVERY_NEEDED')){throw '058B_RECOVERY_BAD_STATUS'};Write-Output ('V462_058B_TEST=PASS;STATUS='+[string]$e.status)",
  "rollback":"Write-Output 'V462_058B_ROLLBACK=NOT_REQUIRED_COORDINATOR_OWNS_WORKER'"
}
