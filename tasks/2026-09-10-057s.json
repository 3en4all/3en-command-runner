{
  "id": "2026-09-10-057s",
  "title": "Externalized OpenClaw admin repair orchestrator",
  "description": "Download and invoke the versioned 057s helper script so the project runner no longer has to parse one giant inline PowerShell script. The helper performs backup, OpenClaw read/write execution, independent test, and rollback.",
  "risk": "medium",
  "backup": "$ErrorActionPreference='Stop';$url='https://raw.githubusercontent.com/3en4all/3en-command-runner/main/scripts/openclaw-admin-repair-057s.ps1';$dst='C:/3EN-Agent/openclaw-admin-repair-057s.ps1';Invoke-WebRequest -UseBasicParsing -Uri ($url+'?ts='+[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()) -OutFile $dst;$tok=$null;$err=$null;[System.Management.Automation.Language.Parser]::ParseFile($dst,[ref]$tok,[ref]$err)|Out-Null;if(@($err).Count -gt 0){throw ('057S_HELPER_SYNTAX_ERRORS='+@($err).Count)};& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $dst -Phase Backup;if($LASTEXITCODE -ne 0){throw ('057S_BACKUP_HELPER_EXIT_'+$LASTEXITCODE)}",
  "script": "$ErrorActionPreference='Stop';$dst='C:/3EN-Agent/openclaw-admin-repair-057s.ps1';if(-not(Test-Path $dst)){throw '057S_HELPER_MISSING'};& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $dst -Phase Execute;if($LASTEXITCODE -ne 0){throw ('057S_EXECUTE_HELPER_EXIT_'+$LASTEXITCODE)}",
  "test": "$ErrorActionPreference='Stop';$dst='C:/3EN-Agent/openclaw-admin-repair-057s.ps1';& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $dst -Phase Test;if($LASTEXITCODE -ne 0){throw ('057S_TEST_HELPER_EXIT_'+$LASTEXITCODE)}",
  "rollback": "$dst='C:/3EN-Agent/openclaw-admin-repair-057s.ps1';if(Test-Path $dst){& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $dst -Phase Rollback}"
}