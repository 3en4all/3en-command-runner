{"id":"security-monitor-002-deploy","title":"Security Monitor 2/3 - deploy bridge","description":"Deploy the local Security Monitor bridge, connect discovered threat evidence with persistent manual block state on 3EN002, and verify live Block/Unblock through the API using a harmless documentation address.","backup":"$ErrorActionPreference='Stop';Write-Host 'SEC_MON_DEPLOY_BACKUP=HANDLED_BY_DEPLOYER_AND_ROUTER_FIREWALL_BACKUP'","script":"$ErrorActionPreference='Stop';$p='C:/3EN-Agent/3en-security-monitor-integration-v1.ps1';& $p -Phase Deploy","test":"$ErrorActionPreference='Stop';$u='http://127.0.0.1:8766';$testIp='192.0.2.254';$b=@{action='block';ips=@($testIp)}|ConvertTo-Json -Depth 5;Invoke-RestMethod -Method Post -Uri ($u+'/api/action') -ContentType 'application/json' -Body $b -TimeoutSec 30|Out-Null;$s=Invoke-RestMethod ($u+'/api/status') -TimeoutSec 12;$x=@($s.items|Where-Object{$_.ip -eq $testIp});if($x.Count -ne 1 -or -not $x[0].blocked){throw 'block verification failed'};$b=@{action='unblock';ips=@($testIp)}|ConvertTo-Json -Depth 5;Invoke-RestMethod -Method Post -Uri ($u+'/api/action') -ContentType 'application/json' -Body $b -TimeoutSec 30|Out-Null;$s=Invoke-RestMethod ($u+'/api/status') -TimeoutSec 12;$x=@($s.items|Where-Object{$_.ip -eq $testIp -and $_.blocked});if($x.Count -ne 0){throw 'unblock verification failed'};Write-Host ('SEC_MON_BLOCK_UNBLOCK_TEST=PASS;THREATS='+@($s.items).Count+';BLOCKED='+$s.blockedCount)","repair":"$ErrorActionPreference='Stop';$p='C:/3EN-Agent/3en-security-monitor-integration-v1.ps1';& $p -Phase Deploy","rollback":"$ErrorActionPreference='Stop';$p='C:/3EN-Agent/3en-security-monitor-integration-v1.ps1';& $p -Phase Rollback"}