{
  "id": "router-pihole-001-discovery",
  "title": "Router + Pi-hole 1/5 - autonomous discovery",
  "description": "Discover the live 3EN002/Pi-hole state, validate SSH/DNS, detect DHCP/DNS relationships and prove whether changing router-own DNS to Pi-hole is loop-safe. No production config change.",
  "backup": "$ErrorActionPreference='Stop';New-Item -ItemType Directory -Force -Path 'C:/3EN-Agent/router-pihole-final'|Out-Null;Write-Host 'DISCOVERY_PREP=PASS'",
  "script": "$ErrorActionPreference='Stop';$u='https://raw.githubusercontent.com/3en4all/3en-command-runner/main/scripts/router-pihole-finalize-v1.ps1';$p='C:/3EN-Agent/router-pihole-finalize-v1.ps1';Invoke-WebRequest -UseBasicParsing -Uri $u -OutFile $p;& $p -Phase Discovery",
  "test": "$ErrorActionPreference='Stop';$s=Get-Content 'C:/3EN-Agent/router-pihole-final/state.json' -Raw|ConvertFrom-Json;if(-not $s.routerSsh){throw 'router discovery incomplete'};if(-not $s.piholeDns){throw 'pihole DNS unavailable'};if([string]$s.router-ne'192.168.1.2' -or [string]$s.pihole-ne'192.168.1.3'){throw 'endpoint mismatch'};Write-Host 'DISCOVERY_TEST=PASS'",
  "repair": "$ErrorActionPreference='Stop';Remove-Item 'C:/3EN-Agent/router-pihole-final/state.json' -Force -ErrorAction SilentlyContinue;$u='https://raw.githubusercontent.com/3en4all/3en-command-runner/main/scripts/router-pihole-finalize-v1.ps1';$p='C:/3EN-Agent/router-pihole-finalize-v1.ps1';Invoke-WebRequest -UseBasicParsing -Uri $u -OutFile $p;& $p -Phase Discovery",
  "rollback": "Write-Host 'DISCOVERY_READ_ONLY_NO_ROLLBACK'"
}