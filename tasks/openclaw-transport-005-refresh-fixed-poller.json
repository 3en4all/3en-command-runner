{
  "id":"openclaw-transport-005-refresh-fixed-poller",
  "title":"Refresh fixed OpenClaw inbox poller and resume v442",
  "description":"Use generic Automation Core to deploy the corrected OpenClaw inbox poller, restart only that poller, clear only its own state, and verify it claims the current OpenClaw pointer without touching OpenClaw Gateway or other automation channels.",
  "risk":"medium",
  "backup":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$bk=$root+'/backups/openclaw-transport-005/'+(Get-Date -Format 'yyyyMMdd-HHmmss');New-Item -ItemType Directory -Force -Path $bk|Out-Null;foreach($f in @('3en-openclaw-inbox.ps1','3en-openclaw-inbox.state.json','3en-openclaw-inbox.log','3en-openclaw-inbox.stdout.log','3en-openclaw-inbox.stderr.log')){$p=$root+'/'+$f;if(Test-Path $p){Copy-Item $p $bk -Force}};Write-Host ('OPENCLAW_005_BACKUP='+$bk)",
  "script":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-openclaw-inbox.ps1';$pattern=[regex]::Escape('3en-openclaw-inbox.ps1');Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{$_.Name -in @('powershell.exe','pwsh.exe') -and $_.CommandLine -match $pattern}|ForEach-Object{Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue};$ts=[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds();Invoke-WebRequest -UseBasicParsing -Uri ('https://raw.githubusercontent.com/3en4all/3en-command-runner/main/automation/3en-openclaw-inbox.ps1?ts='+$ts) -OutFile $poller -TimeoutSec 30;$t=$null;$e=$null;[System.Management.Automation.Language.Parser]::ParseFile($poller,[ref]$t,[ref]$e)|Out-Null;if(@($e).Count -gt 0){throw ('OPENCLAW_005_SYNTAX_ERRORS='+@($e).Count)};$raw=Get-Content $poller -Raw;if($raw -notmatch "'-ProjectPath',\$project\)"){throw 'OPENCLAW_005_FIXED_HANDOFF_MARKER_MISSING'};$state=$root+'/3en-openclaw-inbox.state.json';if(Test-Path $state){Remove-Item $state -Force};Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null;Write-Host 'OPENCLAW_005_RESTARTED'",
  "test":"$ErrorActionPreference='Stop';Start-Sleep 20;$pattern=[regex]::Escape('3en-openclaw-inbox.ps1');$p=Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{$_.Name -in @('powershell.exe','pwsh.exe') -and $_.CommandLine -match $pattern};if(-not $p){throw 'OPENCLAW_005_POLLER_NOT_RUNNING'};$log='C:/3EN-Agent/3en-openclaw-inbox.log';if(-not(Test-Path $log)){throw 'OPENCLAW_005_LOG_MISSING'};$tail=Get-Content $log -Tail 80|Out-String;if($tail -notmatch 'RUNNER START projectArg='){throw 'OPENCLAW_005_FIXED_RUNNER_HANDOFF_NOT_OBSERVED'};Write-Host 'OPENCLAW_005_TEST=PASS'",
  "repair":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-openclaw-inbox.ps1';$pattern=[regex]::Escape('3en-openclaw-inbox.ps1');$p=Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{$_.Name -in @('powershell.exe','pwsh.exe') -and $_.CommandLine -match $pattern};if(-not $p){Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null};Write-Host 'OPENCLAW_005_REPAIR_STARTED'",
  "rollback":"Write-Host 'OPENCLAW_005_ROLLBACK=NO_GATEWAY_OR_OTHER_CHANNEL_CHANGE'"
}
