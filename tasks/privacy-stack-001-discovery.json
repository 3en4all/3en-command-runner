{"id":"privacy-stack-001-discovery","title":"Privacy Stack 1/4 - local discovery","description":"Audit local Python/runtime, existing 3EN Security Monitor candidates and Router/Pi-hole integration state before GUI deployment. Pi-hole SSH management is reported but no longer blocks GUI deployment; write operations remain runtime-gated until SSH is available.","backup":"$ErrorActionPreference='Stop';New-Item -ItemType Directory -Force -Path 'C:/3EN-Agent/security-privacy-stack'|Out-Null;Write-Host 'PRIVACY_DISCOVERY_PREP=PASS'","script":"$ErrorActionPreference='Stop';$p='C:/3EN-Agent/3en-security-privacy-deploy-v1.ps1';Invoke-WebRequest -UseBasicParsing -Uri 'https://raw.githubusercontent.com/3en4all/3en-command-runner/main/scripts/3en-security-privacy-deploy-v1.ps1' -OutFile $p;& $p -Phase Discover","test":"$ErrorActionPreference='Stop';$s=Get-Content 'C:/3EN-Agent/security-privacy-stack/deploy-state.json' -Raw|ConvertFrom-Json;if(-not $s.python){throw 'python missing'};if(-not(Test-Path $s.routerPiState)){throw 'router-pihole state missing'};$rp=Get-Content $s.routerPiState -Raw|ConvertFrom-Json;if(-not $rp.piholeDns){throw 'pihole DNS not healthy'};$mgmt='DEGRADED_READ_ONLY';if([bool]$rp.piSsh){$mgmt='FULL'};Write-Host ('PRIVACY_DISCOVERY_TEST=PASS;PI_SSH='+[bool]$rp.piSsh+';MANAGEMENT_MODE='+$mgmt+';MONITOR_CANDIDATES='+@($s.monitorCandidates).Count)","repair":"$ErrorActionPreference='Stop';$p='C:/3EN-Agent/3en-security-privacy-deploy-v1.ps1';& $p -Phase Discover","rollback":"Write-Host 'DISCOVERY_ONLY_NO_ROLLBACK'"}