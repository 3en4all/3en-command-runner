{"id":"security-monitor-004-openclaw-transport-recovery","title":"Security Monitor 4/4 - recover OpenClaw transport","description":"Refresh the corrected OpenClaw inbox poller from repo, restart only that poller, clear only its own state, and verify it claims the current OpenClaw v442 pointer. Do not touch OpenClaw Gateway, Network Autopilot, or generic project inbox.","backup":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$bk=$root+'/backups/security-monitor-004-openclaw/'+(Get-Date -Format 'yyyyMMdd-HHmmss');New-Item -ItemType Directory -Force -Path $bk|Out-Null;foreach($f in @('3en-openclaw-inbox.ps1','3en-openclaw-inbox.state.json','3en-openclaw-inbox.log')){$p=$root+'/'+$f;if(Test-Path $p){Copy-Item $p $bk -Force}};Write-Host ('SEC_MON_004_BACKUP='+$bk)","script":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-openclaw-inbox.ps1';$pattern=[regex]::Escape('3en-openclaw-inbox.ps1');Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{$_.Name -in @('powershell.exe','pwsh.exe') -and $_.CommandLine -match $pattern}|ForEach-Object{Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue};$ts=[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds();Invoke-WebRequest -UseBasicParsing -Uri ('https://raw.githubusercontent.com/3en4all/3en-command-runner/main/automation/3en-openclaw-inbox.ps1?ts='+$ts) -OutFile $poller -TimeoutSec 30;$t=$null;$e=$null;[System.Management.Automation.Language.Parser]::ParseFile($poller,[ref]$t,[ref]$e)|Out-Null;if(@($e).Count -gt 0){throw ('SEC_MON_004_OPENCLAW_SYNTAX_ERRORS='+@($e).Count)};$raw=Get-Content $poller -Raw;if($raw -notmatch 'Start-Process powershell.exe' -or $raw -notmatch 'ProjectPath'){throw 'SEC_MON_004_FIXED_HANDOFF_MARKER_MISSING'};$state=$root+'/3en-openclaw-inbox.state.json';if(Test-Path $state){Remove-Item $state -Force};Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null;Write-Host 'SEC_MON_004_OPENCLAW_RESTARTED'","test":"$ErrorActionPreference='Stop';Start-Sleep 20;$pattern=[regex]::Escape('3en-openclaw-inbox.ps1');$p=Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{$_.Name -in @('powershell.exe','pwsh.exe') -and $_.CommandLine -match $pattern};if(-not $p){throw 'SEC_MON_004_OPENCLAW_POLLER_NOT_RUNNING'};$log='C:/3EN-Agent/3en-openclaw-inbox.log';if(-not(Test-Path $log)){throw 'SEC_MON_004_OPENCLAW_LOG_MISSING'};$tail=Get-Content $log -Tail 100|Out-String;if($tail -notmatch 'project=project-v442.json'){throw 'SEC_MON_004_V442_NOT_CLAIMED'};Write-Host 'SEC_MON_004_TEST=PASS'","repair":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-openclaw-inbox.ps1';$pattern=[regex]::Escape('3en-openclaw-inbox.ps1');$p=Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{$_.Name -in @('powershell.exe','pwsh.exe') -and $_.CommandLine -match $pattern};if(-not $p){Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null};Write-Host 'SEC_MON_004_REPAIR_STARTED'","rollback":"Write-Host 'SEC_MON_004_ROLLBACK=NO_GATEWAY_OR_OTHER_CHANNEL_CHANGE'"}