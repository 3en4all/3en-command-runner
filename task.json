{
  "id": "2026-09-09-056-network-privacy-handover",
  "title": "AUTONOMOUS HANDOVER - 3EN002 + Pi-hole + Security Privacy Stack",
  "description": "Start the existing five-chapter router/Pi-hole finalization project. Its final chapter automatically hands over to the four-chapter Security & Privacy Stack project. OpenClaw core repair already passed; its isolated agent smoke failure is not allowed to block this independent network project.",
  "risk": "medium",
  "backup": "$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$stamp=Get-Date -Format 'yyyyMMdd-HHmmss';$bk=$root+'/backups/056-network-privacy/'+$stamp;New-Item -ItemType Directory -Force -Path $bk|Out-Null;foreach($f in @('3en-project.state.json','3en-agent.state.json','3en-agent.log')){$p=$root+'/'+$f;if(Test-Path $p){Copy-Item $p $bk -Force}};Write-Host ('NETWORK_PRIVACY_HANDOVER_BACKUP='+$bk)",
  "script": "$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$runner=$root+'/3en-agent-runner-v3.10.1.ps1';$proj=$root+'/project-router-pihole-final.json';Invoke-WebRequest -UseBasicParsing -Uri 'https://raw.githubusercontent.com/3en4all/3en-command-runner/main/3en-agent-runner-v3.10.1.ps1' -OutFile $runner;Invoke-WebRequest -UseBasicParsing -Uri 'https://raw.githubusercontent.com/3en4all/3en-command-runner/main/project-router-pihole-final.json' -OutFile $proj;$t=$null;$e=$null;[System.Management.Automation.Language.Parser]::ParseFile($runner,[ref]$t,[ref]$e)|Out-Null;if(@($e).Count -gt 0){throw ('RUNNER_SYNTAX_ERRORS='+@($e).Count)};$j=Get-Content $proj -Raw|ConvertFrom-Json;if([string]$j.projectId -ne '2026-09-09-router-pihole-final-v1'){throw 'PROJECT_ID_MISMATCH'};if(@($j.chapters).Count -ne 5){throw 'PROJECT_CHAPTER_COUNT_MISMATCH'};$existing=Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-agent-runner-v3\\.10\\.1\\.ps1' -and $_.CommandLine -match 'project-router-pihole-final\\.json'};if(-not $existing){Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',$runner,'-ProjectPath','project-router-pihole-final.json') -WorkingDirectory $root|Out-Null;Write-Host 'ROUTER_PIHOLE_PROJECT_STARTED'}else{Write-Host 'ROUTER_PIHOLE_PROJECT_ALREADY_RUNNING'}",
  "test": "$ErrorActionPreference='Stop';Start-Sleep -Seconds 3;$ok=$false;$p=Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-agent-runner-v3\\.10\\.1\\.ps1' -and $_.CommandLine -match 'project-router-pihole-final\\.json'};if($p){$ok=$true};$state='C:/3EN-Agent/3en-project.state.json';if(Test-Path $state){$raw=Get-Content $state -Raw;if($raw -match '2026-09-09-router-pihole-final-v1'){$ok=$true}};if(-not $ok){throw 'ROUTER_PIHOLE_HANDOVER_NOT_OBSERVED'};Write-Host 'NETWORK_PRIVACY_HANDOVER=PASS'",
  "repair": "$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$runner=$root+'/3en-agent-runner-v3.10.1.ps1';$proj=$root+'/project-router-pihole-final.json';if(-not(Test-Path $runner)){Invoke-WebRequest -UseBasicParsing -Uri 'https://raw.githubusercontent.com/3en4all/3en-command-runner/main/3en-agent-runner-v3.10.1.ps1' -OutFile $runner};if(-not(Test-Path $proj)){Invoke-WebRequest -UseBasicParsing -Uri 'https://raw.githubusercontent.com/3en4all/3en-command-runner/main/project-router-pihole-final.json' -OutFile $proj};Start-Process powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File',$runner,'-ProjectPath','project-router-pihole-final.json') -WorkingDirectory $root|Out-Null;Write-Host 'NETWORK_PRIVACY_HANDOVER_REPAIR_STARTED'",
  "rollback": "Write-Host 'HANDOVER_ONLY: no router or Pi-hole configuration changed by this outer task. Inner projects own backup and rollback.'"
}
