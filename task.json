{
  "id":"automation-core-004-openclaw-inbox-sync-replay",
  "title":"3EN Automation Core - refresh OpenClaw inbox sync and replay current project",
  "description":"Refresh the dedicated OpenClaw inbox with repo project/task synchronization, clear only its own state, restart only its own poller, and replay the current OpenClaw pointer without disturbing generic Security/Privacy or Network Autopilot.",
  "risk":"medium",
  "backup":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$bk=$root+'/backups/openclaw-inbox-sync/'+(Get-Date -Format 'yyyyMMdd-HHmmss');New-Item -ItemType Directory -Force -Path $bk|Out-Null;foreach($f in @('3en-openclaw-inbox.ps1','3en-openclaw-inbox.state.json','3en-openclaw-inbox.log')){$p=$root+'/'+$f;if(Test-Path $p){Copy-Item $p $bk -Force}};Write-Host ('OPENCLAW_SYNC_BACKUP='+$bk)",
  "script":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-openclaw-inbox.ps1';Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-openclaw-inbox\\.ps1'}|ForEach-Object{Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue};$ts=[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds();Invoke-WebRequest -UseBasicParsing -Uri ('https://raw.githubusercontent.com/3en4all/3en-command-runner/main/automation/3en-openclaw-inbox.ps1?ts='+$ts) -OutFile $poller;$t=$null;$e=$null;[System.Management.Automation.Language.Parser]::ParseFile($poller,[ref]$t,[ref]$e)|Out-Null;if(@($e).Count -gt 0){throw ('OPENCLAW_INBOX_SYNTAX_ERRORS='+@($e).Count)};$state=$root+'/3en-openclaw-inbox.state.json';if(Test-Path $state){Remove-Item $state -Force};Start-Process powershell.exe -ArgumentList @('-NoProfile','-WindowStyle','Hidden','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null;Write-Host 'OPENCLAW_INBOX_SYNC_REPLAY_STARTED'",
  "test":"$ErrorActionPreference='Stop';Start-Sleep 6;$p=Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-openclaw-inbox\\.ps1'};if(-not $p){throw 'OPENCLAW_INBOX_PROCESS_NOT_RUNNING'};$log='C:/3EN-Agent/3en-openclaw-inbox.log';if(-not(Test-Path $log)){throw 'OPENCLAW_INBOX_LOG_MISSING'};$tail=Get-Content $log -Tail 30 -ErrorAction Stop|Out-String;if($tail -notmatch '3EN OPENCLAW INBOX START'){throw 'OPENCLAW_INBOX_START_NOT_LOGGED'};Write-Host 'OPENCLAW_INBOX_SYNC_REPLAY_TEST=PASS'",
  "repair":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-openclaw-inbox.ps1';$p=Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-openclaw-inbox\\.ps1'};if(-not $p){Start-Process powershell.exe -ArgumentList @('-NoProfile','-WindowStyle','Hidden','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null};Write-Host 'OPENCLAW_INBOX_SYNC_REPLAY_REPAIR_STARTED'",
  "rollback":"Write-Host 'OPENCLAW_INBOX_SYNC_REPLAY_ROLLBACK=NO_CROSS_CHANNEL_CHANGE'"
}
