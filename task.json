{
  "id":"automation-core-003-openclaw-dedicated-inbox",
  "title":"3EN Automation Core - dedicated OpenClaw inbox",
  "description":"Install and start a dedicated persistent OpenClaw project inbox without disturbing Network Autopilot or the generic Security/Privacy project inbox.",
  "risk":"medium",
  "backup":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$bk=$root+'/backups/openclaw-inbox/'+(Get-Date -Format 'yyyyMMdd-HHmmss');New-Item -ItemType Directory -Force -Path $bk|Out-Null;foreach($f in @('3en-openclaw-inbox.ps1','3en-openclaw-inbox.state.json','3en-openclaw-inbox.log')){$p=$root+'/'+$f;if(Test-Path $p){Copy-Item $p $bk -Force}};Write-Host ('OPENCLAW_INBOX_BACKUP='+$bk)",
  "script":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-openclaw-inbox.ps1';$ts=[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds();Invoke-WebRequest -UseBasicParsing -Uri ('https://raw.githubusercontent.com/3en4all/3en-command-runner/main/automation/3en-openclaw-inbox.ps1?ts='+$ts) -OutFile $poller;$t=$null;$e=$null;[System.Management.Automation.Language.Parser]::ParseFile($poller,[ref]$t,[ref]$e)|Out-Null;if(@($e).Count -gt 0){throw ('OPENCLAW_INBOX_SYNTAX_ERRORS='+@($e).Count)};$runner=$root+'/3en-agent-runner-v4.0.3.ps1';if(-not(Test-Path $runner)){throw 'RUNNER403_MISSING'};$existing=Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-openclaw-inbox\\.ps1'};if(-not $existing){Start-Process powershell.exe -ArgumentList @('-NoProfile','-WindowStyle','Hidden','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null};Write-Host 'OPENCLAW_INBOX_STARTED'",
  "test":"$ErrorActionPreference='Stop';Start-Sleep 4;$p=Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-openclaw-inbox\\.ps1'};if(-not $p){throw 'OPENCLAW_INBOX_PROCESS_NOT_RUNNING'};$log='C:/3EN-Agent/3en-openclaw-inbox.log';if(-not(Test-Path $log)){throw 'OPENCLAW_INBOX_LOG_MISSING'};Write-Host 'OPENCLAW_INBOX_TEST=PASS'",
  "repair":"$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-openclaw-inbox.ps1';if(-not(Test-Path $poller)){Invoke-WebRequest -UseBasicParsing -Uri 'https://raw.githubusercontent.com/3en4all/3en-command-runner/main/automation/3en-openclaw-inbox.ps1' -OutFile $poller};$p=Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-openclaw-inbox\\.ps1'};if(-not $p){Start-Process powershell.exe -ArgumentList @('-NoProfile','-WindowStyle','Hidden','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null};Write-Host 'OPENCLAW_INBOX_REPAIR_STARTED'",
  "rollback":"Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-openclaw-inbox\\.ps1'}|ForEach-Object{Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue};Write-Host 'OPENCLAW_INBOX_ROLLED_BACK'"
}
