{
  "id": "network-autopilot-002-bootstrap-plus-project-inbox",
  "title": "3EN Automation Core - keep network autopilot and restore persistent project inbox",
  "description": "Preserve and start the existing Network Autopilot, then install and start the generic persistent 3EN Project Inbox so future projects are delivered through GitHub without routine user bootstrap commands.",
  "risk": "medium",
  "backup": "$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$bk=$root+'/backups/automation-core/'+(Get-Date -Format 'yyyyMMdd-HHmmss');New-Item -ItemType Directory -Force -Path $bk|Out-Null;foreach($f in @('network-autopilot/3en-network-autopilot-v1.ps1','network-autopilot/state.json','3en-project-inbox.ps1','3en-project-inbox.state.json','3en-project-inbox.log')){$p=$root+'/'+$f;if(Test-Path $p){$d=Join-Path $bk ([IO.Path]::GetFileName($p));Copy-Item $p $d -Force}};Write-Host ('AUTOMATION_CORE_BACKUP='+$bk)",
  "script": "$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-project-inbox.ps1';$ts=[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds();Invoke-WebRequest -UseBasicParsing -Uri ('https://raw.githubusercontent.com/3en4all/3en-command-runner/main/automation/3en-project-inbox.ps1?ts='+$ts) -OutFile $poller;$pt=$null;$pe=$null;[System.Management.Automation.Language.Parser]::ParseFile($poller,[ref]$pt,[ref]$pe)|Out-Null;if(@($pe).Count -gt 0){throw ('PROJECT_INBOX_SYNTAX_ERRORS='+@($pe).Count)};$runner=$root+'/3en-agent-runner-v4.0.3.ps1';if(-not(Test-Path $runner)){throw 'RUNNER403_MISSING'};$existing=Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-project-inbox\\.ps1'};if(-not $existing){Start-Process powershell.exe -ArgumentList @('-NoProfile','-WindowStyle','Hidden','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null};Start-ScheduledTask -TaskName '3EN Network Autopilot' -ErrorAction SilentlyContinue;Write-Host 'AUTOMATION_CORE_STARTED'",
  "test": "$ErrorActionPreference='Stop';Start-Sleep 4;$p=Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue|Where-Object{$_.CommandLine -match '3en-project-inbox\\.ps1'};if(-not $p){throw 'PROJECT_INBOX_PROCESS_NOT_RUNNING'};$ilog='C:/3EN-Agent/3en-project-inbox.log';if(-not(Test-Path $ilog)){throw 'PROJECT_INBOX_LOG_MISSING'};Write-Host 'AUTOMATION_CORE_TEST=PASS'",
  "repair": "$ErrorActionPreference='Stop';$root='C:/3EN-Agent';$poller=$root+'/3en-project-inbox.ps1';if(-not(Test-Path $poller)){Invoke-WebRequest -UseBasicParsing -Uri 'https://raw.githubusercontent.com/3en4all/3en-command-runner/main/automation/3en-project-inbox.ps1' -OutFile $poller};Start-Process powershell.exe -ArgumentList @('-NoProfile','-WindowStyle','Hidden','-ExecutionPolicy','Bypass','-File',$poller) -WorkingDirectory $root|Out-Null;Write-Host 'AUTOMATION_CORE_REPAIR_STARTED'",
  "rollback": "Write-Host 'AUTOMATION_CORE_ROLLBACK=NO_DESTRUCTIVE_CHANGE'"
}
